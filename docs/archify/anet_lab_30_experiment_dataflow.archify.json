  "cards": [
    {
      "dot": "cyan",
      "title": "正本と導出物",
      "items": [
        "metrics.jsonl が scalar と成果物参照の正本で、Run ディレクトリのファイルとして残る",
        "metrics_cache.db は破棄可能な従属導出物で、不整合時は全破棄・再構築する",
        "根拠: docs/adr/0015-metrics-cache-disposable-derivative.md"
      ]
    },
    {
      "dot": "emerald",
      "title": "device と process の境界",
      "items": [
        "Observation と Experience は CPU 上に置き、minibatch だけ学習 device へ転送する",
        "ReplayBuffer は学習プロセス内だけに存在し、Run 成果物へは書き出さない"
      ]
    },
    {
      "dot": "violet",
      "title": "読み書き双方で確認した形式",
      "items": [
        "書き手は run_dir/metrics.jsonl を追記し、images と videos への参照を残す",
        "読み手は metrics.jsonl か metrics.jsonl.gz を選び、無ければ Run として扱わない",
        "根拠: metrics_logger.cpp:190/748/770 / MetricsSource.java:20-29"
      ]
    }
  ]
