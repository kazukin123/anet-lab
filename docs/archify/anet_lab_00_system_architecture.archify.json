  "cards": [
    {
      "dot": "cyan",
      "title": "起動と構築",
      "items": [
        "workspace の config を executable root の設定へ後勝ちで重ね、Run 出力先も同じ workspace へ導出する",
        "--config 指定時は workspace を使わない完全自己記述モードになる",
        "RunManager の構築が成功したときだけ RunnerStatus::RUNNING を立てる"
      ]
    },
    {
      "dot": "emerald",
      "title": "スレッドと device の境界",
      "items": [
        "RunnerThread が DoUpdateFrame(1) を反復し、Env の Step は worker thread へ分配する",
        "Observation と Experience は CPU、NN の forward と backward は学習 device で実行する",
        "PipelineTrainRunner は前回 Experience の学習を専用 LearnThread へ重ねる"
      ]
    },
    {
      "dot": "rose",
      "title": "外部依存とファイル境界",
      "items": [
        "build 宣言の外部依存は libtorch、wxWidgets、Box2D、Catch2、Tracy、NVTX3、nlohmann/json",
        "Atari/ALE は ANET_ENABLE_ATARI と外部 ALE_ROOT 参照によるオプショナルビルド",
        "Run 成果物はファイルとして確定し、Viewer と metrics-tools はそれだけを読む"
      ]
    }
  ]
}