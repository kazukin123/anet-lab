  "cards": [
    {
      "dot": "cyan",
      "title": "起動と構築",
      "items": [
        "OnInit が workspace を解決し、共通 _main.txt に workspace config と key=value を重ねる",
        "Env と Agent の系統は各ライブラリの初期化関数で登録し、RunManager は背景 thread で組み立てる"
      ]
    },
    {
      "dot": "violet",
      "title": "thread と device の境界",
      "items": [
        "TrainThread が行動・Step・学習・通知を順に呼ぶ。Pipeline では学習だけ LearnThread へ移る",
        "Env と ReplayBuffer は CPU。Actor と Learner が入力を device へ移す"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依存とファイル境界",
      "items": [
        "libtorch・wxWidgets・Box2D・Tracy・Catch2。Atari は ALE_ROOT がある時だけ。動画は ffmpeg",
        "Metrics Viewer は Java 17・Spring Boot・SQLite の別 process で、Run フォルダを読むだけ"
      ]
    }
  ]
}