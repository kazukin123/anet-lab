  "cards": [
    {
      "dot": "cyan",
      "title": "設定の解決順",
      "items": [
        "workspace 側の config/_main.txt を executable root の設定へ後勝ちで重ねる",
        "--config 指定時は workspace 解決を迂回し、RunManager が Env / Agent / Runner を構築する",
        "根拠: apps/runner/src/RunnerApp.cpp:231-289 / core/anet-core/src/trainer.cpp:997"
      ]
    },
    {
      "dot": "emerald",
      "title": "反復と終了条件",
      "items": [
        "RunnerThread::ProcessStep が DoUpdateFrame(1) を呼び、COMPLETED まで反復する",
        "train_exit_step または exp_exit_step が STOP を返して Run を完了へ移す",
        "Pause は次 step の抑止であり、進行中の step は中断しない"
      ]
    },
    {
      "dot": "violet",
      "title": "評価が起動する条件",
      "items": [
        "train.eval.[tag] の定義と eval_schedule.[tag].interval>0 が揃ったときだけ生成する",
        "評価メトリクスも同じ Run 成果物へ記録される",
        "根拠: core/anet-core/src/trainer.cpp:864-935 / observers.cpp:527-587"
      ]
    }
  ]
